.venv/
venv/
env/
ENV/
.ENV/
env.bak/
venv.bak/
__pypackages__/

# Node / JS tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# -----------------------------------------------------------------------------
# Environment / secrets
