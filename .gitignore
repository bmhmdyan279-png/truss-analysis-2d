# -----------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
*.cover
*.py,cover
.pytest_cache/
.tox/
.nox/
.hypothesis/
.benchmarks/
nosetests.xml
cover/

