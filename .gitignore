# -----------------------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.whl
*.tar.gz
pip-log.txt
pip-delete-this-directory.txt

# PyInstaller
*.manifest
*.spec

# -----------------------------------------------------------------------------
